# SevaSaathi Backend Environment Variables Template
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/SevaSaathi

# Google Gemini API Key for @google/genai cloud agent
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
